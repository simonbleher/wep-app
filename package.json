{
  "name": "wep-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node tools/update-paket.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ki-test": "vite-node --config tools/ki-test/vite.config.ts tools/ki-test/run.ts --",
    "ki-test:typecheck": "tsc -p tools/ki-test/tsconfig.json --noEmit",
    "ki-test-skizze": "vite-node --config tools/ki-test/vite.config.ts tools/ki-test/run-skizze.ts --",
    "ki-test-chat": "vite-node --config tools/ki-test/vite.config.ts tools/ki-test/run-chat.ts --",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "ki-test-skizze-export": "vite-node --config tools/ki-test/vite.config.ts tools/ki-test/export-skizze.ts --",
    "beta5-paket1:export-bild": "vite-node --config tools/ki-test/vite.config.ts tools/beta5-paket1/export-bild.ts --",
    "beta5-paket1:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/beta5-paket1/screenshots.mjs",
    "beta4-paket3:export-bild": "vite-node --config tools/ki-test/vite.config.ts tools/beta4-paket3/export-bild.ts --",
    "e2e": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/e2e/konto-durchlauf.mjs",
    "umbau:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/umbau/screenshots.mjs",
    "icons": "node tools/icons/erzeuge-icons.mjs",
    "icons:windows": "node tools/icons/erzeuge-windows-icons.mjs",
    "tauri": "tauri",
    "windows:bauen": "npm run build && node -e \"require('fs').rmSync('dist/updates',{recursive:true,force:true})\" && tauri build --bundles nsis",
    "beta4-paket1:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/beta4-paket1/screenshots.mjs",
    "beta4-paket2:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/beta4-paket2/screenshots.mjs",
    "beta4-paket3:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/beta4-paket3/screenshots.mjs",
    "beta4-paket4:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/beta4-paket4/screenshots.mjs",
    "beta4-paket5:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/beta4-paket5/screenshots.mjs",
    "paket1:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/paket1/screenshots.mjs",
    "paket2:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/paket2/screenshots.mjs",
    "paket3:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/paket3/screenshots.mjs",
    "paket4:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/paket4/screenshots.mjs",
    "paket5:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/paket5/screenshots.mjs",
    "paket6:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/paket6/screenshots.mjs",
    "paket7:screenshots": "VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000 vite build --outDir dist-e2e && node tools/paket7/screenshots.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.30.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capgo/capacitor-updater": "^8.53.0",
    "@tauri-apps/api": "^2.12.4",
    "idb": "^8.0.3",
    "jszip": "^3.10.2",
    "lucide-react": "0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@napi-rs/canvas": "^1.0.11",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.9.12",
    "mammoth": "^1.13.0",
    "playwright": "^1.64.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.0"
  }
}
