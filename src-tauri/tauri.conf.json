{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WEP",
  "version": "0.1.6",
  "identifier": "de.wep.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "WEP – Wertermittlungsprotokoll",
        "width": 1200,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "WEP",
    "shortDescription": "Wertermittlungsprotokoll im Kleingarten",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["wep"],
        "name": "WEP-Datei",
        "description": "Geteiltes Wertermittlungsprotokoll (WEP)",
        "mimeType": "application/x-wep",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://wep-pankow-apk.pages.dev/windows/latest.json"],
      "pubkey": "",
      "windows": { "installMode": "passive" }
    }
  }
}
